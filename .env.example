# Flask Configuration
FLASK_ENV=production
# Required in production; the app refuses to start without it.
# Generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-this-to-a-random-secret-key

# Database (Railway sets DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Email (Resend HTTP API; SENDGRID_API_KEY is used instead if RESEND_API_KEY is not set)
RESEND_API_KEY=your-resend-api-key
# Must be on a domain verified with the provider
MAIL_DEFAULT_SENDER=Wishlist <wishlist@yourdomain.com>

# App Settings
APP_NAME=Power Family Wishlist

# WebAuthn / Passkey Configuration
# RP_ID should be your domain without port (e.g., giftexchange.example.com)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Power Family Wishlist
# ORIGIN must include scheme and port if non-standard (e.g., https://giftexchange.example.com)
WEBAUTHN_ORIGIN=http://localhost:5000
